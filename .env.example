NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for webhook intake and the workflow run engine.
# Never expose through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Base64-encoded 32-byte key used to encrypt integration
# credentials at rest. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Server-only. Enables AI workflow output (lead analysis, message drafts).
# When unset, workflows still run with deterministic rule-based fallbacks,
# clearly labeled in run detail.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-4-8.
AI_MODEL=

# Server-only. Guards POST /api/jobs/run (the durable-job runner). Point a
# scheduler (Vercel Cron, GitHub Actions, …) at it every 1-5 minutes with
# Authorization: Bearer $CRON_SECRET. Generate with: openssl rand -hex 24
CRON_SECRET=

# Voice provider (docs/20, docs/21). "openai_realtime" is the shipped
# adapter: set VOICE_PROVIDER=openai_realtime + OPENAI_API_KEY below and
# the AI phone assistant works for browser test calls and the simulated
# harness. Real carrier calls additionally need a phone bridge (docs/21).
# VOICE_PROVIDER_API_KEY is only for future adapters (twilio_voice,
# retell, vapi) — OpenAI Realtime reads OPENAI_API_KEY instead.
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=

# Server-only. OpenAI key for the Realtime voice assistant (docs/21).
# Browsers only ever receive short-lived client secrets minted server-side.
OPENAI_API_KEY=
# Optional overrides. Model defaults to gpt-realtime (gpt-realtime-mini is
# the cheaper option); voice defaults to marin (cedar/marin are GA voices).
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
# Text model for the simulated-call harness (same instructions + tools
# over text). Defaults to gpt-4o-mini.
OPENAI_SIM_MODEL=
# Reserved for the phone bridge (docs/21): signature secret for inbound
# call webhooks (e.g. OpenAI SIP webhooks). Unused until the bridge ships.
OPENAI_REALTIME_WEBHOOK_SECRET=

# NOTE: HubSpot, GoHighLevel, Twilio (SMS), Resend, and Google Calendar
# credentials are NOT environment variables. They are entered per client in
# the Setup checklist, verified against the provider, and stored encrypted
# (SECRETS_ENCRYPTION_KEY above). The website chat widget key is generated
# per client on the web-chat connection page — also not an env var.
