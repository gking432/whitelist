NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production Docker deployment. Point both DNS records at the server.
APP_DOMAIN=
VOICE_DOMAIN=

# Temporary internal Scenario Lab. Leave disabled in production; enable only
# in a protected staging environment when interactive workflow testing is needed.
ENABLE_SCENARIO_LAB=false

# Server-only. Required for webhook intake and the workflow run engine.
# Never expose through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Base64-encoded 32-byte key used to encrypt integration
# credentials at rest. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Server-only. Enables AI workflow output (lead analysis, message drafts).
# When unset, workflows still run with deterministic rule-based fallbacks,
# clearly labeled in run detail.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-4-8.
AI_MODEL=

# Server-only. Guards POST /api/jobs/run (the durable-job runner). Point a
# scheduler (Vercel Cron, GitHub Actions, …) at it every 1-5 minutes with
# Authorization: Bearer $CRON_SECRET. Generate with: openssl rand -hex 24
CRON_SECRET=

# Platform-owned sender for partner/owner support alerts. Requests remain in
# the durable outbox until these are configured; the job runner sends them.
PLATFORM_RESEND_API_KEY=
PLATFORM_ALERT_FROM_EMAIL=
PLATFORM_ALERT_FROM_NAME=Platform Support

# Voice provider (docs/20, docs/21). "openai_realtime" is the shipped
# adapter: set VOICE_PROVIDER=openai_realtime + OPENAI_API_KEY below and
# the AI phone assistant works for browser tests and Twilio Voice calls.
# Twilio credentials are stored per client through Setup, not in this file.
# VOICE_PROVIDER_API_KEY is reserved for future Retell/Vapi adapters.
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=

# Server-only. OpenAI key for the Realtime voice assistant (docs/21).
# Browsers only ever receive short-lived client secrets minted server-side.
OPENAI_API_KEY=
# Optional overrides. Model defaults to gpt-realtime (gpt-realtime-mini is
# the cheaper option); voice defaults to marin (cedar/marin are GA voices).
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
# Text model for the simulated-call harness (same instructions + tools
# over text). Defaults to gpt-4o-mini.
OPENAI_SIM_MODEL=
# Reserved for a future direct OpenAI SIP webhook. Twilio Voice verifies
# calls with the encrypted Twilio auth token entered in client Setup.
OPENAI_REALTIME_WEBHOOK_SECRET=

# Northstar-owned provider applications. Configure these once for the whole
# platform; clients authorize their own accounts without creating developer apps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
JOBBER_OAUTH_CLIENT_ID=
JOBBER_OAUTH_CLIENT_SECRET=
QUICKBOOKS_OAUTH_CLIENT_ID=
QUICKBOOKS_OAUTH_CLIENT_SECRET=
SQUARE_OAUTH_CLIENT_ID=
SQUARE_OAUTH_CLIENT_SECRET=
RINGCENTRAL_OAUTH_CLIENT_ID=
RINGCENTRAL_OAUTH_CLIENT_SECRET=
DIALPAD_OAUTH_CLIENT_ID=
DIALPAD_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
META_WEBHOOK_VERIFY_TOKEN=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=
PODIUM_OAUTH_CLIENT_ID=
PODIUM_OAUTH_CLIENT_SECRET=

# Public WebSocket endpoint used by Twilio Media Streams for staff-assisted
# calls, plus the shared secret used between that stream and the web app.
NORTHSTAR_VOICE_STREAM_URL=
VOICE_STREAM_SHARED_SECRET=
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Dedicated connector-development worker. Keep disabled on the public web
# process unless it has a separate disposable checkout and trusted Codex auth.
ENABLE_CODEX_CONNECTOR_WORKER=false
CODEX_CONNECTOR_WORKSPACE_PATH=

# NOTE: HubSpot, GoHighLevel, Resend, Stripe, CallRail, and Quo credentials are stored encrypted per
# client. Twilio is owned by each partner and provisions isolated client
# subaccounts. Google, Microsoft, Jobber, QuickBooks, Square, RingCentral,
# and Dialpad use the platform OAuth applications above.
